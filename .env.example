# ============================================================================
# VIDSYNTH AI — SERVER ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and configure your private server-side credentials.
# Never commit .env or expose secret keys/tokens in frontend code.
# ============================================================================

PORT=3000
NODE_ENV=development

# Authentication & Database Persistence (Server-Side Secret Key Only)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_publishable_anon_key_here
SUPABASE_SECRET_KEY=your_private_service_role_secret_key_here

# AI Image Generation & Editing Engine (Server-Side Only)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
